# Your production domain (used for sitemap, robots.txt, Open Graph)
# On Vercel this is optional — VERCEL_URL is used automatically if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Live demo URLs (Vercel frontends) — shown as "Live demo" on project cards.
# Set these after deploying each project's web/ folder to Vercel (see each repo's DEPLOY.md).
NEXT_PUBLIC_DEMO_DELIVERY_URL=https://your-delivery-demo.vercel.app
NEXT_PUBLIC_DEMO_SAAS_URL=https://your-saas-demo.vercel.app
NEXT_PUBLIC_DEMO_AI_URL=https://your-ai-demo.vercel.app
